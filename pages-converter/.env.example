# LINE Messaging API (LINE Developers console > your channel)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DEFAULT_FORMAT=pdf

# Public URL of this service, used to build download links sent to LINE
PUBLIC_BASE_URL=https://your-service.onrender.com

# Optional: require header X-API-Key on /api/convert (for n8n / Make workflows)
API_KEY=

MAX_UPLOAD_MB=50
FILE_TTL_MINUTES=60
MAX_PARALLEL=2
